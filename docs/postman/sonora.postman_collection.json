        },
        {
          "name": "Baixar num formato",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/songs/{{songId}}/download?format=mp3",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "songs",
                "{{songId}}",
                "download"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "mp3"
                }
              ]
            },
            "description": "Status: implementado e respondendo.\n\nResponde 302 para uma URL assinada do R2. Formatos: mp3, wav, flac, opus, m4a. O que ainda não existe é transcodificado sob demanda e fica 7 dias em cache. Free só baixa MP3; o limite vem do plano."
          }
        },
        {
          "name": "Baixar várias de uma vez (ZIP)",
          "request": {
            "method": "POST",
            "header": [
