                "{{apiUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-out"
              ]
            },
            "description": "Status: implementado e respondendo.\n\nIdempotente: sair sem estar logado responde 200 em vez de erro.\n\nNão exige sessão.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Geração",
      "item": [
        {
          "name": "Criar música — aba Simple",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"simple\",\n  \"prompt\": \"pop rock brasileiro, violão e bateria ao vivo, clima de estrada\",\n  \"instrumental\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/songs/generate",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "songs",
                "generate"
              ]
            },
            "description": "Status: implementado e respondendo.\n\nReserva os créditos, cria a música com status queued e enfileira o job. Responde 402 quando falta saldo e 403 quando a duração passa do limite do plano."
          }
        },
        {
          "name": "Criar música — aba Advanced",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"advanced\",\n  \"lyrics\": \"[Verse]\\\\nAcordei com o sol batendo na janela\\\\n\\\\n[Chorus]\\\\nVou seguir a estrada até o mar\",\n  \"title\": \"Estrada até o mar\",\n  \"instrumental\": false,\n  \"controls\": {\n    \"styles\": \"pop rock brasileiro, violão, bateria ao vivo\",\n    \"excludeStyles\": \"distorção, autotune\",\n    \"vocalGender\": \"male\",\n    \"bpm\": 104,\n    \"key\": \"G\",\n    \"weirdness\": 50,\n    \"styleInfluence\": 50,\n    \"variety\": \"high\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/songs/generate",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "songs",
                "generate"
              ]
            },
            "description": "Status: implementado e respondendo.\n\nSem durationSeconds a duração é automática (decidida pelo tamanho da letra), que foi o que soou mais natural nos testes. Exclusões de voz viram instrumental nativo."
          }
        },
        {
          "name": "Criar som curto — aba Sounds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"sounds\",\n  \"prompt\": \"stab de synth analógico quente\",\n  \"soundType\": \"one-shot\",\n  \"bpm\": 120,\n  \"key\": \"Cm\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/songs/generate",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "songs",
                "generate"
              ]
            },
            "description": "Status: implementado e respondendo."
          }
        },
        {
          "name": "Progresso ao vivo (SSE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/generations/stream",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "generations",
                "stream"
              ]
            },
            "description": "Status: implementado e respondendo.\n\nServer-Sent Events. Emite queued, compiling_prompt, writing_lyrics, generating_audio, uploading, generating_cover e complete. O Postman mostra o stream; no navegador use EventSource."
          }
        },
