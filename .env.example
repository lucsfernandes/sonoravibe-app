# ---------------------------------------------------------------------------
# Sonora — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Banco e fila -----------------------------------------------------------
DATABASE_URL=postgresql://sonora:sonora@localhost:55432/sonora
REDIS_URL=redis://localhost:56379
# Cria o schema a partir das entidades. SOMENTE desenvolvimento:
# em producao o schema vem de migrations (a config recusa isso com NODE_ENV=production).
DB_SYNCHRONIZE=true

# --- OpenRouter -------------------------------------------------------------
# Uma única chave atende música, letra/prompt e capa.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo de música. Pro = música completa (~3min, $0.08). Clip = 30s ($0.04).
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview
OPENROUTER_CLIP_MODEL=google/lyria-3-clip-preview

# LLM barato para letra, prompt compiler e título.
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash

# Modelo de imagem para a capa.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Cabeçalhos de atribuição exigidos pela OpenRouter.
OPENROUTER_APP_NAME=Sonora
OPENROUTER_SITE_URL=https://sonora.app

# Provider ativo: 'lyria' em produção, 'mock' para desenvolver sem gastar crédito.
MUSIC_PROVIDER=mock

# --- Cloudflare R2 ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sonora-audio
# Domínio público do bucket (ou domínio customizado na frente do R2)
R2_PUBLIC_URL=https://cdn.sonora.app

# --- Better Auth ------------------------------------------------------------
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Asaas ------------------------------------------------------------------
# Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
# Provider ativo: 'asaas' ou 'fake'
PAYMENT_PROVIDER=fake

# --- Aplicação --------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Caminho dos binários. Variável AUSENTE ou vazia = usa o nome padrão, que é
# procurado no PATH. Foi um FFMPEG_PATH vazio que um dia derrubou o motor de
# áudio e fez o roteador cair no provedor pago; hoje a configuração trata
# "vazio" como "não configurado", mas não há motivo para deixar em branco.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Demucs — separação de stems. Precisa estar instalado no worker; sem ele, a
# rota aceita o pedido e o job falha com mensagem explícita.
DEMUCS_PATH=demucs

# Quantas gerações o worker atende ao mesmo tempo. Em produção fica 1: cada job
# pode chamar o FFmpeg, e três em paralelo disputam a mesma CPU sem ganho real.
WORKER_CONCURRENCY=3

# Arquivo que o worker toca a cada 30s. É o que o liveness probe do Kubernetes
# observa — ele não atende HTTP, então um probe HTTP falharia sempre.
HEARTBEAT_PATH=/tmp/heartbeat

# Aponta para o emulador local do SDK da RunPod, quando estiver testando o
# worker de GPU sem gastar com a nuvem. Vazio = usa a RunPod de verdade.
RUNPOD_BASE_URL=
